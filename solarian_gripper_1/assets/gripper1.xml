<?xml version='1.0' encoding='utf-8'?>
<mujoco model="gripper1">
  <compiler angle="radian" meshdir="gripper1_description/meshes" autolimits="true" inertiafromgeom="auto" inertiagrouprange="3 3" />
  <default>
    <default class="gripper1">
      <joint frictionloss="0.1" armature="0.005" />
      <!-- N/m on the carriage slide: stiff like the real STS3250, so the
           carriage reaches the command (within ~1 mm) through fingertip drag on
           the table. The squeeze on an object is set by finger_flex, not this. -->
      <position kp="5000" dampratio="1" />
      <!-- Lumped TPU fin-ray compliance: each finger hinges outward about the
           base of its inner face on a torsion spring, so the carriage keeps
           closing after the pads meet an object, as on the real gripper. The
           policies learned from that: real grasps keep closing to a ~20 mm
           reading, and with rigid fingers the carriages stall at the object
           width, which the place policy reads (off the finger holders, see
           screw_hole) as already releasing.
           A hinge rather than a slide because the real finger's base is clamped
           to its carriage; only the part out toward the tip gives.
           4.8 N m/rad is ~400 N/m at a block held near the tips (0.11 m out),
           tuned, not measured: the reading tracks the command within ~1.5 mm
           under load (the real gripper's ~0.6 mm), and a 12 g block or 60 g
           motor stays put through a 6-8 mm partial reopen (the place policy's
           first chunks). Stiffer only raises the squeeze. -->
      <default class="finger_flex">
        <joint type="hinge" axis="0 1 0" stiffness="4.8" damping="0.01" springref="0" frictionloss="0.01" armature="0.0001" />
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
        <!-- The three screw holes on each finger holder's top face, located by
             casting the camera rays through the dark holes in a real wrist frame.
             Real, they are dark marks moving with the fingers, and the place
             policy reads the opening off them: with the CAD's light bosses it
             read the sim gripper 10-15 mm wider than its reading and kept
             opening until the block fell. MuJoCo has no ambient occlusion, so a
             hole renders as bright as the face around it. -->
        <default class="screw_hole">
          <geom type="cylinder" size="0.0018 0.00015" quat="0.707107 0.707107 0 0" material="screw_hole" />
        </default>
      </default>
      <default class="collision">
        <geom group="3" density="522" contype="2" conaffinity="1" />
        <!-- Fingers are padded with 3M TB641 gripping material. Its datasheet
             mu of 3.5 is against its mating 3M material; a Shore 40A elastomer
             on wood or plastic is ~1-1.5. Priority makes these parameters govern
             every pad contact instead of being mixed with the other geom's.
             MuJoCo's default contact (solref 0.02, solimp dmax 0.95) is a spring
             whose stiffness scales with the bodies' mass: ~500 N/m against a 12 g
             block, so the pads sank 5-11 mm into the block instead of the
             fingers flexing. A 0.004 s time constant (2 x timestep, the
             stiffest MuJoCo allows) with dmax 0.99 is ~100 times stiffer.
             Torsional friction (m, needs condim 4) is the pad's contact patch
             resisting a block pivoting about the line between the fingers:
             ~2/3 of a 15 mm patch radius times mu. -->
        <default class="finger_pad">
          <geom condim="4" friction="1.5 0.02 0.0001" priority="1" solref="0.004 1" solimp="0.95 0.99 0.001" />
        </default>
      </default>
    </default>
  </default>
